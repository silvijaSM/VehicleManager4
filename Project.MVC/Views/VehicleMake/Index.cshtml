@model Project.Service.Models.ViewModels.VehicleMakeView

@{
    ViewData["Title"] = "Vehicle make";
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 10;
    var currentFilter = ViewData["CurrentFilter"] as string ?? "";
    var sortOrder = ViewData["CurrentSort"] as string ?? "";
}

<h1>Vehicle Make</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Find by name: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" />
            <input type="submit" value="Search" class="btn btn-primary" /> |
            <a asp-action="Index" class="btn btn-secondary">Back to Full List</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@(ViewData["NameSortParm"] ?? "name_desc")" asp-route-currentFilter="@ViewData["CurrentFilter"]">Name</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@(ViewData["AbrvSortParm"] ?? "abrv_desc")" asp-route-currentFilter="@ViewData["CurrentFilter"]">Abrv</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Makes != null)
        {
            foreach (var item in Model.Makes)
            {
                <tr>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        @item.Abrv
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="pagination">
    <ul class="pagination-list">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="pagination-item @(i == currentPage ? "is-active" : "")">
                <a asp-action="Index" asp-route-pageNumber="@i" asp-route-sortOrder="@sortOrder" asp-route-currentFilter="@currentFilter">
                    @i
                </a>
            </li>
        }
    </ul>
</div>
