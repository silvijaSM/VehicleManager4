                <div class="form-group">
                    <label asp-for="Abrv" class="control-label"></label>
                    <input asp-for="Abrv" class="form-control" />
                    <span asp-validation-for="Abrv" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
