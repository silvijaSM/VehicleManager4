@model Project.MVC.Models.ViewModels.VehicleModelView

@{
    ViewData["Title"] = "Create";
}

<h2>Create new vehicle model</h2>

<div>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create">
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Abrv" class="control-label"></label>
                    <input asp-for="Abrv" class="form-control" />
                    <span asp-validation-for="Abrv" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="hidden" asp-for="MakeID" value="@ViewBag.MakeID" />
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>