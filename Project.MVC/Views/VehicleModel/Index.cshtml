@model PaginatedList<Project.MVC.Models.ViewModels.VehicleModelView>

@{
    ViewData["Title"] = "Vehicle Model";
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var currentFilter = ViewData["CurrentFilter"] as string ?? "";
    var sortOrder = ViewData["CurrentSort"] as string ?? "";
}

<h1>Vehicle Model</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Find by name: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" />
            <input type="submit" value="Search" class="btn btn-primary" /> |
            <a asp-action="Index" class="btn btn-secondary">Back to Full List</a>
        </p>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@sortOrder" asp-route-currentFilter="@currentFilter">Name</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@sortOrder" asp-route-currentFilter="@currentFilter">Abrv</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@sortOrder" asp-route-currentFilter="@currentFilter">MakeId</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        @item.Abrv
                    </td>
                    <td>
                        @item.MakeID
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="pagination">
    <ul class="pagination-list">
        @if (Model != null && Model.HasPreviousPage)
        {
            <li class="pagination-item">
                <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-sortOrder="@sortOrder" asp-route-currentFilter="@currentFilter">Previous</a>
            </li>
        }

        @if (Model != null)
        {
            <li class="pagination-item @(Model.PageIndex == Model.TotalPages ? "is-active" : "")">
                <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-sortOrder="@sortOrder" asp-route-currentFilter="@currentFilter">Next</a>
            </li>
        }
    </ul>
</div>